{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "SNI Conecta Design System",
  "version": "2.7.0",
  "organization": "SEICHO-NO-IE DO BRASIL",
  "color": {
    "navy": {
      "$description": "Azul institucional amostrado do logo. Barra lateral e superfícies de marca. Não é o azul de ação.",
      "900": { "$value": "#0D1A4E", "$type": "color" },
      "800": { "$value": "#101E58", "$type": "color" },
      "700": { "$value": "#132460", "$type": "color" },
      "600": { "$value": "#1B2E6E", "$type": "color" }
    },
    "blue": {
      "$description": "Azul de interface. Botões, links, estados.",
      "50":  { "$value": "#EEF3FC", "$type": "color" },
      "100": { "$value": "#D0DFFA", "$type": "color" },
      "200": { "$value": "#A3BFF4", "$type": "color" },
      "300": { "$value": "#6B94EC", "$type": "color" },
      "400": { "$value": "#3A6FE0", "$type": "color" },
      "500": { "$value": "#1C4CC7", "$type": "color" },
      "600": { "$value": "#163BA3", "$type": "color" },
      "700": { "$value": "#0F2B7A", "$type": "color" },
      "800": { "$value": "#091D57", "$type": "color" },
      "900": { "$value": "#050F30", "$type": "color" }
    },
    "gray": {
      "50":  { "$value": "#F8F9FB", "$type": "color" },
      "100": { "$value": "#EFF1F5", "$type": "color" },
      "200": { "$value": "#D9DDE6", "$type": "color" },
      "300": { "$value": "#B8BFD0", "$type": "color" },
      "400": { "$value": "#8E97AE", "$type": "color" },
      "500": { "$value": "#616B84", "$type": "color" },
      "600": { "$value": "#424B63", "$type": "color" },
      "700": { "$value": "#2C3348", "$type": "color" },
      "800": { "$value": "#1A1F2E", "$type": "color" },
      "900": { "$value": "#0F1219", "$type": "color" }
    },
    "ink": {
      "$description": "Grafite neutro do tema escuro. Não usar o navy escurecido.",
      "900": { "$value": "#0E1013", "$type": "color", "$description": "fundo da aplicação" },
      "800": { "$value": "#14161A", "$type": "color", "$description": "superfície de conteúdo" },
      "700": { "$value": "#1A1D22", "$type": "color", "$description": "superfície elevada" },
      "600": { "$value": "#23272E", "$type": "color", "$description": "hover" }
    },
    "semantic": {
      "$description": "Escurecidas em relação ao v1 para fechar 4,5:1 em texto pequeno.",
      "success":    { "$value": "#15803D", "$type": "color" },
      "successBg":  { "$value": "#DCFCE7", "$type": "color" },
      "warning":    { "$value": "#B45309", "$type": "color" },
      "warningBg":  { "$value": "#FEF3C7", "$type": "color" },
      "danger":     { "$value": "#B91C1C", "$type": "color" },
      "dangerBg":   { "$value": "#FEE2E2", "$type": "color" },
      "info":       { "$value": "#0369A1", "$type": "color" },
      "infoBg":     { "$value": "#E0F2FE", "$type": "color" }
    },
    "accent": {
      "$description": "Azul de ação. Usar sempre este token, nunca blue.600 direto — ele troca com o tema.",
      "light":      { "$value": "{color.blue.600}", "$type": "color" },
      "lightHover": { "$value": "{color.blue.700}", "$type": "color" },
      "dark":       { "$value": "#3A6FE0", "$type": "color" },
      "darkHover":  { "$value": "#5583E8", "$type": "color" }
    },
    "text": {
      "light": {
        "1": { "$value": "{color.gray.900}", "$type": "color" },
        "2": { "$value": "{color.gray.700}", "$type": "color" },
        "3": { "$value": "{color.gray.600}", "$type": "color" },
        "4": { "$value": "{color.gray.500}", "$type": "color" }
      },
      "dark": {
        "1": { "$value": "#F2F3F5", "$type": "color", "$description": "não usar branco puro: gera halo" },
        "2": { "$value": "rgba(255,255,255,0.80)", "$type": "color" },
        "3": { "$value": "rgba(255,255,255,0.64)", "$type": "color" },
        "4": { "$value": "rgba(255,255,255,0.46)", "$type": "color" }
      }
    }
  },
  "glass": {
    "$description": "Camada funcional apenas: topbar, menus, modais, barras flutuantes. Nunca em conteúdo. Nunca vidro sobre vidro.",
    "frost":      { "$value": "20px", "$type": "dimension" },
    "saturation": { "$value": "150%", "$type": "other", "$description": "obrigatório junto do blur" },
    "surface": {
      "light": { "$value": "rgba(255,255,255,0.86)", "$type": "color" },
      "dark":  { "$value": "rgba(26,29,34,0.82)", "$type": "color" }
    },
    "hover": {
      "light": { "$value": "rgba(255,255,255,0.96)", "$type": "color" },
      "dark":  { "$value": "rgba(35,39,46,0.92)", "$type": "color" }
    },
    "edge": {
      "light": { "$value": "rgba(255,255,255,0.70)", "$type": "color" },
      "dark":  { "$value": "rgba(255,255,255,0.09)", "$type": "color" }
    },
    "specular": {
      "light": { "$value": "inset 0 1px 0 rgba(255,255,255,0.95)", "$type": "shadow" },
      "dark":  { "$value": "inset 0 1px 0 rgba(255,255,255,0.06)", "$type": "shadow" }
    }
  },
  "button": {
    "$description": "Reflexo idêntico em todas as variantes sólidas: primary, danger, success.",
    "specular": {
      "light": { "$value": "inset 0 1px 0 rgba(255,255,255,0.22), inset 0 -1px 1px rgba(0,0,0,0.10)", "$type": "shadow" },
      "dark":  { "$value": "inset 0 1px 0 rgba(255,255,255,0.16), inset 0 -1px 1px rgba(0,0,0,0.22)", "$type": "shadow" }
    },
    "sheen": { "$value": "linear-gradient(180deg, rgba(255,255,255,0.10), rgba(255,255,255,0) 58%)", "$type": "gradient" }
  },
  "shadow": {
    "light": {
      "1": { "$value": "0 1px 3px rgba(13,26,78,0.07)", "$type": "shadow" },
      "2": { "$value": "0 8px 24px rgba(13,26,78,0.09), 0 1px 3px rgba(13,26,78,0.05)", "$type": "shadow" },
      "3": { "$value": "0 20px 48px rgba(13,26,78,0.16), 0 3px 8px rgba(13,26,78,0.07)", "$type": "shadow" }
    },
    "dark": {
      "1": { "$value": "0 1px 3px rgba(0,0,0,0.50)", "$type": "shadow" },
      "2": { "$value": "0 8px 24px rgba(0,0,0,0.48), 0 1px 3px rgba(0,0,0,0.38)", "$type": "shadow" },
      "3": { "$value": "0 20px 48px rgba(0,0,0,0.60), 0 3px 8px rgba(0,0,0,0.42)", "$type": "shadow" }
    }
  },
  "radius": {
    "$description": "Cápsula em controle, raio moderado em superfície. Aninhamento: interno = externo − padding.",
    "pill":  { "$value": "999px", "$type": "dimension", "$description": "botões, chips, marcadores, chaves" },
    "field": { "$value": "12px",  "$type": "dimension", "$description": "inputs, selects, textareas" },
    "tile":  { "$value": "14px",  "$type": "dimension", "$description": "itens de lista, caixas de ícone" },
    "card":  { "$value": "18px",  "$type": "dimension", "$description": "cards, tabelas, painéis internos" },
    "panel": { "$value": "24px",  "$type": "dimension", "$description": "modais, painéis externos" }
  },
  "font": {
    "sans":  { "$value": "Figtree, system-ui, -apple-system, sans-serif", "$type": "fontFamily", "$description": "voz da ferramenta" },
    "serif": { "$value": "Platypi, Georgia, 'Times New Roman', serif", "$type": "fontFamily", "$description": "voz da instituição — nunca abaixo de 16px, nunca em número ou botão" },
    "mono":  { "$value": "'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace", "$type": "fontFamily", "$description": "voz do dado — pesos 500 e 600 apenas" }
  },
  "type": {
    "pageTitle":   { "font": "{font.serif}", "size": "26px", "weight": 700, "lineHeight": 1.2,  "letterSpacing": "-0.01em", "wrap": "balance" },
    "sectionTitle":{ "font": "{font.serif}", "size": "18px", "weight": 700, "lineHeight": 1.15, "letterSpacing": "0", "transform": "uppercase", "wrap": "balance" },
    "screenTitle": { "font": "{font.sans}",  "size": "17px", "weight": 700 },
    "cardTitle":   { "font": "{font.sans}",  "size": "16px", "weight": 700, "wrap": "balance" },
    "body":        { "font": "{font.sans}",  "size": "15px", "weight": 400, "lineHeight": 1.6, "wrap": "pretty" },
    "support":     { "font": "{font.sans}",  "size": "13.5px", "weight": 400, "wrap": "pretty" },
    "minimum":     { "size": "13px", "$description": "mínimo absoluto da interface — nada abaixo disso" },
    "metric":      { "font": "{font.mono}",  "size": "31px", "weight": 600, "letterSpacing": "-0.02em" },
    "tabular":     { "font": "{font.mono}",  "size": "14.5px", "weight": 500, "letterSpacing": "-0.01em" },
    "voice":       { "font": "{font.serif}", "size": "16px", "weight": 400, "style": "italic", "$description": "estado vazio, primeiro acesso, conclusão" }
  },
  "a11y": {
    "tapTarget":      { "$value": "44px", "$type": "dimension" },
    "tapGap":         { "$value": "8px",  "$type": "dimension" },
    "focusRing":      { "$value": "3px solid {color.accent.light}", "$type": "border" },
    "focusOffset":    { "$value": "2px",  "$type": "dimension" },
    "minContrast":    { "$value": "4.5:1", "$type": "other", "$description": "medido depois do blur, contra o pior ponto do fundo" },
    "mediaQueries": [
      "prefers-reduced-transparency: reduce",
      "prefers-contrast: more",
      "prefers-reduced-motion: reduce"
    ]
  },
  "motion": {
    "duration": { "$value": "0.18s", "$type": "duration" },
    "easing":   { "$value": "cubic-bezier(0.32, 0.72, 0, 1)", "$type": "cubicBezier" }
  },
  "naming": {
    "$description": "Regra editorial de nomenclatura. Violação é erro, não questão de estilo.",
    "movement": {
      "form": "Seicho-No-Ie",
      "rule": "Livre. Caixa mista no corpo do texto ou caixa alta em título, ambas corretas."
    },
    "entity": {
      "form": "SEICHO-NO-IE DO BRASIL",
      "rule": "Sempre em caixa alta, sem exceção. A forma em caixa mista com 'do Brasil' em minúsculas nunca pode aparecer. Escrever a caixa alta no conteúdo, não via text-transform. Nunca quebrar em duas linhas."
    },
    "product": {
      "form": "SNI Conecta",
      "rule": "Iniciais maiúsculas sempre."
    },
    "hyphens": "Obrigatórios nas duas formas. Não existe 'Seicho No Ie' nem 'SEICHO NO IE'."
  }
}
