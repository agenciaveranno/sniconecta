# ── Supabase (obrigatórias) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Ignora RLS: use apenas onde src/lib/auth.ts e os
# fluxos controlados pedem, sempre com auditoria.
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao Postgres pelo POOLER em modo transação (porta 6543),
# usada pelo módulo eventos (src/lib/db.ts). Nunca a porta 5432 direta
# em serverless.
DATABASE_URL=postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# ── Segredos de infraestrutura ───────────────────────────────────────
# Sem ela a rota da fila de notificações fica fechada.
CRON_SECRET=
# ≥32 caracteres. Cifra credencial guardada no banco (src/lib/cripto.ts).
CREDENCIAIS_ENCRYPTION_KEY=

# ── Endereço público ─────────────────────────────────────────────────
# Entra no link do magic link, do comprovante e do certificado. Sem ela cai
# em VERCEL_PROJECT_PRODUCTION_URL, que é o domínio gerado da Vercel — e o
# link que chega por e-mail deixa de ser o da instituição.
NEXT_PUBLIC_SITE_URL=https://sniconecta.com.br

# ── Só para o script de migração (scripts/migrar-mysql.ts) ───────────
# Usuário SOMENTE LEITURA no MySQL do Railway. Nunca o usuário da aplicação.
MIGRACAO_MYSQL_URL=mysql://leitura:senha@host:3306/railway
